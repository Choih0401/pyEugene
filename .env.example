# Copy to .env and fill in for real mode. In mock mode (default) none of
# these except EUGENE_MOCK_MODE matter.

# --- Eugene Champion OpenAPI login (real mode only) ---
EUGENE_USER_ID=
EUGENE_USER_PW=
EUGENE_CERT_PW=

# Only needed for a 제휴사(partner) 신청계좌 - if set, logs in with
# CommLoginPartner instead of CommLogin. Leave blank for a personal account.
EUGENE_PARTNER_CODE=

# true (default): FakeEugeneManager answers every call with synthetic data.
# Runs on any OS, no Windows/Champion OpenAPI/account required - use this to
# explore the generated Swagger UI at /docs.
# false: real mode - requires 32-bit Windows, the Champion OpenAPI OCX
# installed and registered, and pyeugene's Windows-only dependencies
# (pywin32, PyQt5) installed in the venv.
EUGENE_MOCK_MODE=true

# Required in real mode. Sent by every client as the `X-API-Key` header.
EUGENE_API_KEY=

# Must be explicitly set to true to expose order/cancel/amend TR codes
# (Subject ending in "U", e.g. OTD1101U 주식 주문). Left false by default
# so a freshly started server cannot place trades.
EUGENE_ENABLE_TRADING=false

# Seconds a GET /real/{code}/snapshot call waits for one matching update
# before returning 408.
EUGENE_REAL_SNAPSHOT_TIMEOUT=5

# Seconds any single TR/method call to pyeugene is allowed to block before
# this server gives up and returns 502, instead of the HTTP request hanging
# forever if the Champion OpenAPI session stops responding.
EUGENE_CALL_TIMEOUT_SECONDS=30
